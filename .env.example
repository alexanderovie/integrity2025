# Integrity Clean Solutions - Environment Variables
# Copia este archivo a .env.local y completa con tus valores reales
# NUNCA commitees .env.local con valores reales

# ============================================
# Supabase (Authentication & Database)
# ============================================

# ============================================
# Stripe (Payments)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# Resend (Email Service)
# ============================================
RESEND_API_KEY=re_your_resend_api_key

# ============================================
# HubSpot (CRM)
# ============================================
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your_hubspot_portal_id
ENABLE_HUBSPOT_WEBHOOK_VERIFICATION=true

# ============================================
# Meta Pixel (Facebook/Meta Tracking)
# ============================================
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
META_PIXEL_ACCESS_TOKEN=your_meta_pixel_access_token
NEXT_PUBLIC_META_TEST_EVENT_CODE=your_test_event_code_optional

# ============================================
# Meta Marketing API (Optional)
# ============================================
META_MARKETING_API_TOKEN=your_meta_marketing_api_token

# ============================================
# Vercel (Deployment - Auto-configured)
# ============================================
# Vercel configura estas automáticamente en producción
# No necesitas configurarlas localmente

# ============================================
# Development
# ============================================
NODE_ENV=development
