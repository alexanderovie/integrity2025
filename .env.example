# Integrity Clean Solutions - Environment Variables
# Copia este archivo a .env.local y completa con tus valores reales
# NUNCA commitees .env.local con valores reales

# ============================================
# Supabase (Authentication & Database)
# ============================================

# ============================================
# Stripe (Payments)
# ============================================
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ============================================
# Resend (Email Service)
# ============================================
RESEND_API_KEY=your_resend_api_key

# ============================================
# HubSpot (CRM)
# ============================================
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your_hubspot_portal_id
ENABLE_HUBSPOT_WEBHOOK_VERIFICATION=true

# ============================================
# Meta Pixel (Facebook/Meta Tracking)
# ============================================
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
META_PIXEL_ACCESS_TOKEN=your_meta_pixel_access_token
NEXT_PUBLIC_META_TEST_EVENT_CODE=your_test_event_code_optional

# ============================================
# Meta Marketing API (Optional)
# ============================================
META_MARKETING_API_TOKEN=your_meta_marketing_api_token

# ============================================
# Vercel (Deployment - Auto-configured)
# ============================================
# Vercel configura estas automáticamente en producción
# No necesitas configurarlas localmente
NEXT_PUBLIC_APP_URL=https://integritycleansolutions.com

# ============================================
# Sanity (Headless CMS for blog)
# Project: integrity-clean-solutions (fybafzhk)
# ============================================
NEXT_PUBLIC_SANITY_PROJECT_ID=fybafzhk
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_read_token_here

# ============================================
# Database (Neon)
# ============================================
DATABASE_URL=postgresql://user:password@host/dbname

# ============================================
# Security Headers / CSP
# ============================================
# Opciones válidas para CSP_MODE: report-only | enforce
CSP_MODE=report-only
# Opcional: endpoint para reportes CSP
CSP_REPORT_URI=

# ============================================
# Testing (Optional)
# ============================================
# Required only to run smoke tests against protected Vercel previews
VERCEL_AUTOMATION_BYPASS_SECRET=
# Enable verbose client-side CWV logs (development/debug only)
NEXT_PUBLIC_WEB_VITALS_DEBUG=false

# ============================================
# Development
# ============================================
NODE_ENV=development
