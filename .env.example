# Integrity Clean Solutions - Environment Variables
# Copia este archivo a .env.local y completa con tus valores reales
# NUNCA commitees .env.local con valores reales

# ============================================
# Supabase (Authentication & Database)
# ============================================

# ============================================
# Stripe (Payments)
# ============================================
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ============================================
# Resend (Email Service)
# ============================================
RESEND_API_KEY=your_resend_api_key
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret

# ============================================
# HubSpot (CRM)
# ============================================
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your_hubspot_portal_id
ENABLE_HUBSPOT_WEBHOOK_VERIFICATION=true

# ============================================
# Meta Pixel (Facebook/Meta Tracking)
# ============================================
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
META_PIXEL_ACCESS_TOKEN=your_meta_pixel_access_token
NEXT_PUBLIC_META_TEST_EVENT_CODE=your_test_event_code_optional

# ============================================
# Meta Marketing API (Optional)
# ============================================
META_MARKETING_API_TOKEN=your_meta_marketing_api_token

# ============================================
# Vercel (Deployment - Auto-configured)
# ============================================
# Vercel configura estas automáticamente en producción
# No necesitas configurarlas localmente
NEXT_PUBLIC_APP_URL=https://integritycleansolutions.com

# ============================================
# Sanity (Headless CMS for blog)
# Create project at https://www.sanity.io/manage
# ============================================
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=your_sanity_write_token
SANITY_API_READ_TOKEN=your_sanity_read_token

# ============================================
# Upstash Redis (Rate Limiting & Security)
# Create database at https://console.upstash.com/redis
# ============================================
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ============================================
# Next.js Cache Revalidation
# Generate secret with: openssl rand -base64 32
# Required for on-demand ISR from CLI scripts
# ============================================
REVALIDATE_SECRET=your_revalidate_secret_here

# ============================================
# Internal API
# Generate secret with: openssl rand -base64 32
# Required for internal operational endpoints.
# ============================================
INTERNAL_API_SECRET=your_internal_api_secret_here

# ============================================
# Development
# ============================================
NODE_ENV=development
