{
  "name": "gleamer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^10.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true pnpm build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix --max-warnings=0",
    "type-check": "tsc --noEmit",
    "verify": "pnpm run lint && pnpm run type-check && pnpm run build",
    "doctor": "tsx scripts/doctor.ts",
    "precommit": "pnpm verify",
    "prepush": "pnpm doctor",
    "sanity": "sanity",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:schema:extract": "sanity schema extract --enforce-required-fields",
    "sanity:typegen": "pnpm run sanity:schema:extract && sanity typegen generate",
    "sanity:typegen:watch": "sanity typegen generate --watch",
    "sanity:graphql:deploy": "sanity graphql deploy",
    "sanity:documents:migrate": "sanity documents migrate",
    "sanity:migrate": "node scripts/migrate-to-sanity.mjs",
    "content:migrate": "node scripts/migrate-content-to-sanity.mjs",
    "email:dev": "email dev --dir src/emails --port 3001",
    "email:render": "tsx scripts/email-render.tsx",
    "email:test": "tsx scripts/email-test.tsx",
    "vercel:pull": "vercel pull --yes",
    "vercel:build": "pnpm type-check && vercel build --prod --yes",
    "vercel:build:local": "vercel build --yes",
    "vercel:deploy:prebuilt": "vercel deploy --prebuilt --prod --yes",
    "vercel:verify": "pnpm run lint && pnpm run type-check && vercel pull --yes && vercel build --prod --yes && echo '✅ Vercel build OK'",
    "vercel:link": "vercel link"
  },
  "dependencies": {
    "@hubspot/api-client": "^13.5.0",
    "@iconify/icons-ion": "^1.2.10",
    "@iconify/tools": "^4.1.2",
    "@next/third-parties": "^16.2.6",
    "@portabletext/react": "^6.2.0",
    "@sanity/image-url": "^2.1.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "libphonenumber-js": "^1.13.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "next-sanity": "^12.4.5",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "19.2.6",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.6",
    "react-email": "6.1.1",
    "react-fast-marquee": "^1.6.5",
    "react-intersection-observer": "^9.16.0",
    "resend": "^6.12.3",
    "sanity": "^5.24.0",
    "stripe": "19.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@iconify/react": "^5.2.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "^16.1.6",
    "@next/mdx": "^16.1.1",
    "@playwright/test": "^1.58.1",
    "@react-email/ui": "^6.1.1",
    "@sanity/client": "^7.17.0",
    "@stripe/stripe-js": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "gray-matter": "^4.0.3",
    "mdx": "^0.3.1",
    "next-mdx-remote": "^6.0.0",
    "playwright": "^1.58.1",
    "reading-time": "^1.5.0",
    "tailwindcss": "4.0.0",
    "tsx": "^4.7.0",
    "tw-animate-css": "^1.2.8",
    "typescript": "5.6.3"
  }
}
