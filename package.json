{
  "name": "gleamer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix --max-warnings=0",
    "type-check": "tsc --noEmit",
    "verify": "pnpm run lint && pnpm run type-check && pnpm run build",
    "doctor": "tsx scripts/doctor.ts",
    "precommit": "pnpm verify",
    "prepush": "pnpm doctor",
    "vercel:pull": "vercel pull --yes",
    "vercel:build": "pnpm type-check && vercel build --prod --yes",
    "vercel:build:local": "vercel build --yes",
    "vercel:deploy:prebuilt": "vercel deploy --prebuilt --prod --yes",
    "vercel:verify": "pnpm run lint && pnpm run type-check && vercel pull --yes && vercel build --prod --yes && echo '✅ Vercel build OK'",
    "vercel:link": "vercel link"
  },
  "dependencies": {
    "@iconify/icons-ion": "^1.2.10",
    "@iconify/tools": "^4.1.2",
    "@next/third-parties": "^16.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.33.0",
    "libphonenumber-js": "^1.12.36",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.11.0",
    "react": "19.2.4",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.4",
    "react-fast-marquee": "^1.6.5",
    "react-intersection-observer": "^9.16.0",
    "resend": "^6.0.2",
    "stripe": "19.3.1",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@iconify/react": "^5.2.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.1",
    "@playwright/test": "^1.58.1",
    "@stripe/stripe-js": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "gray-matter": "^4.0.3",
    "mdx": "^0.3.1",
    "next-mdx-remote": "^6.0.0",
    "playwright": "^1.58.1",
    "reading-time": "^1.5.0",
    "tailwindcss": "4.0.0",
    "tsx": "^4.7.0",
    "tw-animate-css": "^1.2.8",
    "typescript": "5.6.3"
  }
}
