{
  "name": "gleamer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "verify": "pnpm run lint && pnpm run type-check && pnpm run build",
    "vercel:pull": "vercel pull --yes",
    "vercel:build": "vercel build --prod --yes",
    "vercel:build:local": "vercel build --yes",
    "vercel:deploy:prebuilt": "vercel deploy --prebuilt --prod --yes",
    "vercel:verify": "pnpm run lint && pnpm run type-check && vercel pull --yes && vercel build --prod --yes && echo '✅ Vercel build OK'",
    "vercel:link": "vercel link"
  },
