# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report/
test-results/
/tmp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.deb

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# environment variables
.env
.env.local
.env*.local
.env*.backup
.env*.bak
*.env
.env.production
.env.development
.env.test
.env.vercel
.env.vercel.*

# secrets and keys
*.key
*.pem
*.p12
*.pfx
*.secret
secrets/
*.token
*.password

# logs (may contain sensitive info)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# internal docs (no públicos)
.docs/

# local CLI profiles and pulled env snapshots
.stripe/
